# Copy to .env and fill in. `.env` is gitignored and must stay mode 0600.

# ── Used once, by `npm run cf:setup` ─────────────────────────────────────
# Account-owned token with `Account API Tokens: Write`, so it can mint the
# narrow deploy token. It cannot publish and cannot touch DNS.
# Create one at https://dash.cloudflare.com/profile/api-tokens
# Remove this line once `npm run cf:setup` has succeeded.
cloudflare_admin_api_token=

# ── Written by `npm run cf:setup`, used by `npm run deploy` ─────────────
# Scoped token: `Pages Write` on one account, plus `DNS Write` on the zone
# only when site.config.json lists a custom domain. Never commit this.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Used by `npm run refresh` ────────────────────────────────────────────
# Optional. Without it GitHub's traffic API returns no numbers and the site
# falls back to sorting by creation date only.
GITHUB_TOKEN=
