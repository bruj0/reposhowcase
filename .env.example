# Copy to .env and fill in. `.env` is gitignored and must stay mode 0600.
#
# Write values here yourself. Never paste a token into a conversation, an issue
# or a commit: `npm run secrets:check` reports whether a key is present without
# printing it, so there is never a reason to show one.
#
# Only some of these are needed. `deploy.targets` decides which: a GitHub Pages
# site published from its own repository needs none of them.

# ── Used once, by `npm run cf:setup` ─────────────────────────────────────
# Account-owned token with `Account API Tokens: Write`, so it can mint the
# narrow deploy token. It cannot publish and cannot touch DNS.
# Create one at https://dash.cloudflare.com/profile/api-tokens
# Remove this line once `npm run cf:setup` has succeeded.
cloudflare_admin_api_token=

# ── Written by `npm run cf:setup`, used by `npm run deploy` ─────────────
# Scoped token: `Pages Write` on one account, plus `DNS Write` on the zone
# only when site.config.json lists a custom domain. Never commit this.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Used by `npm run refresh` ────────────────────────────────────────────
# Optional. Without it GitHub's traffic API returns no numbers and the site
# falls back to sorting by creation date only.
GITHUB_TOKEN=

# ── Used by `npm run deploy:gh` when the artifact goes to another repo ───
# Only needed when `deploy.githubPages.repository` names a repository other
# than this one AND the push cannot use SSH. A local deploy over SSH with a key
# that already reaches the repository needs nothing here.
#
# Fine-grained PAT, `Contents: write` on that one repository, nothing else.
GH_TOKEN=
