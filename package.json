{
  "name": "reposhowcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn one GitHub account into a catalogue page of the applications it shipped.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:gh": "DEPLOY_TARGET=github-pages astro build",
    "preview": "astro preview",
    "refresh": "node scripts/fetch-repos.mjs",
    "cf:setup": "node scripts/cf-setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:cf": "node scripts/cf-deploy.mjs",
    "deploy:gh": "node scripts/gh-deploy.mjs",
    "secrets:check": "node scripts/secrets-check.mjs",
    "check:config": "node scripts/check-config.mjs",
    "compare:sites": "node scripts/compare-sites.mjs",
    "sync:essay": "node scripts/sync-essay.mjs",
    "release:check": "node scripts/release.mjs --check",
    "release:sync": "node scripts/release.mjs --sync"
  },
  "dependencies": {
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  }
}
